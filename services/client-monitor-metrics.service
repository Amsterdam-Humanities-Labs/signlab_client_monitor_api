[Unit]
Description=Client Monitor Metrics Collector
Documentation=https://github.com/yourorg/client-monitor-api
After=network-online.target mysql.service
Wants=network-online.target
StartLimitIntervalSec=600

[Service]
Type=simple
User=gomer
Group=gomer
WorkingDirectory=/web/client_monitor_api/services
ExecStart=/usr/bin/python3 /web/client_monitor_api/services/metrics_collector.py

# Restart configuration
Restart=always
RestartSec=60
StartLimitBurst=5

# Logging
StandardOutput=append:/var/log/client_monitor_metrics.log
StandardError=append:/var/log/client_monitor_metrics_error.log

# Environment
Environment="PYTHONUNBUFFERED=1"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
